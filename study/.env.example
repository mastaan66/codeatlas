# Optional — enables hosted Gemma 4 via the Gemini API (faster responses).
# Without it, SnapStudy runs fully offline on local Ollama open weights.
GEMINI_API_KEY=

# Optional overrides
# GEMMA_MODEL=gemma-4-26b-a4b-it   # or gemma-4-31b-it
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:latest
# PORT=3002

# Ollama fallback when the Gemini API fails. Default: on only when
# GEMINI_API_KEY is absent (pure-offline mode). On machines with little RAM,
# loading the ~10 GB local model mid-request can OOM-kill the server, so with
# a key configured the fallback stays off unless you opt in.
# OLLAMA_FALLBACK=on   # or off
